LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Telegram（可選，不用 Telegram 留空即可）
TELEGRAM_BOT_TOKEN=
# 本機開發用 ngrok：TELEGRAM_WEBHOOK_URL=https://xxxx.ngrok.io/telegram-webhook
# Railway 部署會自動從 RAILWAY_PUBLIC_DOMAIN 組合，不需手動設定
TELEGRAM_WEBHOOK_URL=

# Neon PostgreSQL 連線字串（未設定則自動 fallback 到本機 SQLite）
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# 每次即時查詢最多爬幾頁（15筆/頁）。本機測試建議設 1，正式建議 3
MAX_CRAWL_PAGES=3

# 排程爬蟲最多爬幾頁（0 = 不限，抓全部約 2700+ 筆）
MAX_CRAWL_PAGES_SCHEDULED=0

# 詳細頁爬取間隔（秒），避免對 DGPA 造成過大負擔
CRAWL_DETAIL_DELAY=0.3

# 回傳給使用者的最大職缺數
TOP_K_RESULTS=5
