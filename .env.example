LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Telegram（可選，不用 Telegram 留空即可）
TELEGRAM_BOT_TOKEN=
# 本機開發用 ngrok：TELEGRAM_WEBHOOK_URL=https://xxxx.ngrok.io/telegram-webhook
# Render 部署會自動從 RENDER_EXTERNAL_URL 組合，不需手動設定
TELEGRAM_WEBHOOK_URL=

# 每次查詢最多爬幾頁（15筆/頁）。本機測試建議設 1，正式建議 3~5，0 = 不限
MAX_CRAWL_PAGES=3

# 回傳給使用者的最大職缺數
TOP_K_RESULTS=5
